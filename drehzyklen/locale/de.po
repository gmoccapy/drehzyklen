#: drehzyklen/geometry.py:62
msgid "Two consecutive points are identical"
msgstr "Zwei aufeinanderfolgende Punkte sind identisch"

#: drehzyklen/geometry.py:325
#, python-brace-format
msgid "Line {line}: corner size must not be negative"
msgstr "Zeile {line}: Eckengröße darf nicht negativ sein"

#: drehzyklen/geometry.py:332
#, python-brace-format
msgid "Line {line}: angle A/B only together with a chamfer C"
msgstr "Zeile {line}: Winkel A/B nur zusammen mit einer Fase C"

#: drehzyklen/geometry.py:340
#, python-brace-format
msgid "Line {line}: chamfer angle must be between 0 and 180°"
msgstr "Zeile {line}: Fasenwinkel muss zwischen 0 und 180° liegen"

#: drehzyklen/geometry.py:365
#, python-brace-format
msgid "Line {line}: unknown text '{text}'"
msgstr "Zeile {line}: unbekannter Text '{text}'"

#: drehzyklen/geometry.py:372
#, python-brace-format
msgid "Line {line}: {word} takes no number"
msgstr "Zeile {line}: {word} hat keinen Zahlenwert"

#: drehzyklen/geometry.py:377
#, python-brace-format
msgid "Line {line}: {word} without a number"
msgstr "Zeile {line}: {word} ohne Zahlenwert"

#: drehzyklen/geometry.py:381
#, python-brace-format
msgid "Line {line}: unknown word '{word}'"
msgstr "Zeile {line}: unbekanntes Wort '{word}'"

#: drehzyklen/geometry.py:391
#, python-brace-format
msgid "Line {line}: only G1, G2 and G3 are allowed"
msgstr "Zeile {line}: nur G1, G2 und G3 sind erlaubt"

#: drehzyklen/geometry.py:401
#, python-brace-format
msgid "Line {line}: U without a previous X value"
msgstr "Zeile {line}: U ohne vorherigen X-Wert"

#: drehzyklen/geometry.py:408
#, python-brace-format
msgid "Line {line}: W without a previous Z value"
msgstr "Zeile {line}: W ohne vorherigen Z-Wert"

#: drehzyklen/geometry.py:416 drehzyklen/geometry.py:422
#, python-brace-format
msgid "Line {line}: the first point needs X and Z"
msgstr "Zeile {line}: Der erste Punkt braucht X und Z"

#: drehzyklen/geometry.py:425
#, python-brace-format
msgid "Line {line}: negative diameter X{value}"
msgstr "Zeile {line}: negativer Durchmesser X{value}"

#: drehzyklen/geometry.py:431
#, python-brace-format
msgid "Line {line}: the contour must start with a point"
msgstr "Zeile {line}: Die Kontur muss mit einem Punkt beginnen"

#: drehzyklen/geometry.py:443
#, python-brace-format
msgid "Line {line}: arc radius must be positive"
msgstr "Zeile {line}: Bogenradius muss positiv sein"

#: drehzyklen/geometry.py:451
#, python-brace-format
msgid "Line {line}: an arc needs R, I/K, TS or TE"
msgstr "Zeile {line}: Bogen braucht R, I/K, TS oder TE"

#: drehzyklen/geometry.py:454
#, python-brace-format
msgid "Line {line}: {words} only with G2/G3"
msgstr "Zeile {line}: {words} nur bei G2/G3"

#: drehzyklen/geometry.py:465
msgid "The contour needs at least two points"
msgstr "Die Kontur braucht mindestens zwei Punkte"

#: drehzyklen/geometry.py:514
#, python-brace-format
msgid "Point {point}: arc has the same start and end point"
msgstr "Punkt {point}: Bogen hat gleichen Anfangs- und Endpunkt"

#: drehzyklen/geometry.py:521
#, python-brace-format
msgid "Point {point}: radius R{radius} too small - at least R{minimum}"
msgstr "Punkt {point}: Radius R{radius} zu klein – mindestens R{minimum}"

#: drehzyklen/geometry.py:542
#, python-brace-format
msgid "Point {point}: centre lies on the start point"
msgstr "Punkt {point}: Mittelpunkt liegt auf dem Anfangspunkt"

#: drehzyklen/geometry.py:546
#, python-brace-format
msgid "Point {point}: end point is not on the circle around the centre (deviation {deviation:.3f} mm)"
msgstr "Punkt {point}: Endpunkt liegt nicht auf dem Kreis um den Mittelpunkt (Abweichung {deviation:.3f} mm)"

#: drehzyklen/geometry.py:553
#, python-brace-format
msgid "Point {point}: 'tangential at start' needs a previous element"
msgstr "Punkt {point}: 'tangential am Anfang' braucht ein vorheriges Element"

#: drehzyklen/geometry.py:559
#, python-brace-format
msgid "Point {point}: 'tangential at end' needs a following line"
msgstr "Punkt {point}: 'tangential am Ende' braucht eine folgende Gerade"

#: drehzyklen/geometry.py:567
#, python-brace-format
msgid "Point {point}: end point lies on the tangent - use a line here"
msgstr "Punkt {point}: Endpunkt liegt auf der Tangente – hier passt eine Gerade"

#: drehzyklen/geometry.py:593
#, python-brace-format
msgid "Point {point}: chamfer {size} is longer than the element"
msgstr "Punkt {point}: Fase {size} ist länger als das Element"

#: drehzyklen/geometry.py:610
#, python-brace-format
msgid "Point {point}: a chamfer with this angle does not reach the neighbouring edge"
msgstr "Punkt {point}: Fase mit diesem Winkel trifft die Nachbarkante nicht"

#: drehzyklen/geometry.py:623
#, python-brace-format
msgid "Point {point}: the contour turns back, no corner possible"
msgstr "Punkt {point}: Kontur kehrt um, Ecke nicht möglich"

#: drehzyklen/geometry.py:642
#, python-brace-format
msgid "Point {point}: radius R{radius} does not fit this corner (not enough room)"
msgstr "Punkt {point}: Radius R{radius} passt nicht an diese Ecke (zu wenig Platz)"

#: drehzyklen/geometry.py:713
#, python-brace-format
msgid "Point {point}: same point as before"
msgstr "Punkt {point}: gleicher Punkt wie davor"

#: drehzyklen/geometry.py:763
#, python-brace-format
msgid "Not enough room for the radii/chamfers between point {first} and {second}"
msgstr "Zwischen Punkt {first} und {second} ist zu wenig Platz für die Radien/Fasen"

#: drehzyklen/geometry.py:828
msgid "The contour runs back against the machining direction in places. Roughing is not possible there."
msgstr "Die Kontur läuft stellenweise gegen die Bearbeitungsrichtung zurück. Dort ist Schruppen nicht möglich."

#: drehzyklen/geometry.py:835
msgid "The contour contains an undercut - the tool enters at an angle."
msgstr "Die Kontur enthält einen Hinterschnitt – es wird schräg eingefahren."

