msgstr "Bohrung ist zu klein für den Sicherheitsabstand"

#: drehzyklen/cycles/turning.py:106
#, python-brace-format
msgid "Roughing: {count} levels"
msgstr "Schruppen: {count} Ebenen"

#: drehzyklen/cycles/turning.py:184
msgid "Contour with arcs in radius mode G8: X = radius, I/K = centre relative"
msgstr "Kontur mit Bögen im Radiusmodus G8: X = Radius, I/K = Mittelpunkt relativ"

