#: drehzyklen/cycles/thread.py:125
#, python-brace-format
msgid "Pre-turn the bore to Ø{pre:.2f} (core Ø D1 {core:.2f} + 0.1·P)"
msgstr "Bohrung vordrehen auf Ø{pre:.2f} (Kern-Ø D1 {core:.2f} + 0,1·P)"

#: drehzyklen/cycles/thread.py:129
#, python-brace-format
msgid "Pre-turn to Ø{pre:.2f} (nominal Ø - 0.1·P)"
msgstr "Vordrehen auf Ø{pre:.2f} (Nenn-Ø − 0,1·P)"

#: drehzyklen/cycles/thread.py:156
#, python-brace-format
msgid "inside core hole Ø{diameter}×P{pitch}"
msgstr "innen Kernloch Ø{diameter}×P{pitch}"

#: drehzyklen/cycles/thread.py:159
#, python-brace-format
msgid "outside M{diameter}×{pitch}"
msgstr "außen M{diameter}×{pitch}"

#: drehzyklen/cycles/thread.py:214
msgid "Start and end of the thread are equal"
msgstr "Gewindeanfang und -ende sind gleich"

#: drehzyklen/cycles/thread.py:217
msgid "The start point Zs must lie before the start of the thread (against the thread direction)"
msgstr "Der Startpunkt Zs muss vor dem Gewindeanfang liegen (entgegen der Gewinderichtung)"

#: drehzyklen/cycles/thread.py:220
msgid "The first depth of cut is larger than the thread depth"
msgstr "Erste Zustellung ist größer als die Gewindetiefe"

#: drehzyklen/cycles/thread.py:222
msgid "The distance of the drive line is larger than the core hole radius"
msgstr "Abstand der Zustelllinie ist größer als der Kernlochradius"

#: drehzyklen/cycles/thread.py:228
#, python-brace-format
msgid "Run-in {run_in:.2f} mm is short (acceleration distance ≈ {needed:.2f} mm) - move the start point further away or reduce the speed"
msgstr "Anlaufweg {run_in:.2f} mm ist knapp (Beschleunigungsweg ≈ {needed:.2f} mm) – Startpunkt weiter weg legen oder Drehzahl senken"

#: drehzyklen/cycles/thread.py:232
#, python-brace-format
msgid "{passes} thread passes + {spring} spring pass(es); spindle encoder required"
msgstr "{passes} Gewindeschnitte + {spring} Leerschnitt(e); Spindel-Encoder erforderlich"

#: drehzyklen/cycles/thread.py:250
#, python-brace-format
msgid "{tool}: a {kind} cannot cut a thread - choose a threading tool"
msgstr "{tool}: Mit {kind} kann kein Gewinde geschnitten werden – Gewindewerkzeug wählen"

#: drehzyklen/cycles/thread.py:253
#, python-brace-format
msgid "{tool}: an inside thread needs an inside threading tool"
msgstr "{tool}: Innengewinde braucht ein Innen-Gewindewerkzeug"

#: drehzyklen/cycles/thread.py:256
#, python-brace-format
msgid "{tool}: an outside thread needs an outside threading tool"
msgstr "{tool}: Außengewinde braucht ein Außen-Gewindewerkzeug"

#: drehzyklen/cycles/thread.py:260
#, python-brace-format
msgid "{tool}: tip angle {angle:g}° does not fit {thread} ({needed:g}°)"
msgstr "{tool}: Spitzenwinkel {angle:g}° passt nicht zu {thread} ({needed:g}°)"

#: drehzyklen/cycles/thread.py:277
msgid "G76 in radius mode G8 (I, J, K as radius values), then back to G7"
msgstr "G76 im Radiusmodus G8 (I, J, K als Radiuswerte), danach zurück zu G7"

#: drehzyklen/cycles/toolcheck.py:45
#, python-brace-format
msgid "{tool}: a threading tool is not suitable for turning"
msgstr "{tool}: Gewindewerkzeug ist für Drehbearbeitung nicht geeignet"

#: drehzyklen/cycles/toolcheck.py:47
#, python-brace-format
msgid "{tool}: a drill is not suitable for turning"
msgstr "{tool}: Bohrer ist für Drehbearbeitung nicht geeignet"

#: drehzyklen/cycles/toolcheck.py:53
#, python-brace-format
msgid "{tool}: wrong tool position - inside machining needs an inside tool"
msgstr "{tool}: Werkzeuglage passt nicht – für Innenbearbeitung wird ein Innenwerkzeug gebraucht"

#: drehzyklen/cycles/toolcheck.py:55
#, python-brace-format
msgid "{tool}: wrong tool position - outside machining needs an outside tool"
msgstr "{tool}: Werkzeuglage passt nicht – für Außenbearbeitung wird ein Außenwerkzeug gebraucht"

#: drehzyklen/cycles/toolcheck.py:60
msgid "left-hand (cuts towards +Z)"
msgstr "links (schneidet nach +Z)"

#: drehzyklen/cycles/toolcheck.py:62
msgid "right-hand (cuts towards -Z)"
msgstr "rechts (schneidet nach -Z)"

#: drehzyklen/cycles/toolcheck.py:63
#, python-brace-format
msgid "{tool}: wrong cutting direction - a {needed} tool is needed here"
msgstr "{tool}: Schnittrichtung passt nicht – hier wird ein Werkzeug {needed} gebraucht"

#: drehzyklen/cycles/toolcheck.py:79
#, python-brace-format
msgid "{tool}: clearance angle too small for the contour (a section falls by {angle:.0f}°) - choose a tool with a sharper insert (e.g. ISO V) or the matching hand"
msgstr "{tool}: Freiwinkel reicht nicht für die Kontur (Abschnitt fällt um {angle:.0f}°) – Werkzeug mit spitzerer Platte (z.B. ISO V) oder passender Hand wählen"

#: drehzyklen/cycles/turning.py:71
