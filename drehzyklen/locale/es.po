#, python-brace-format
msgid "{tool}: a threading tool is not suitable for turning"
msgstr "{tool}: una herramienta de roscar no es apta para tornear"

#: drehzyklen/cycles/toolcheck.py:47
#, python-brace-format
msgid "{tool}: a drill is not suitable for turning"
msgstr "{tool}: una broca no es apta para tornear"

#: drehzyklen/cycles/toolcheck.py:53
#, python-brace-format
msgid "{tool}: wrong tool position - inside machining needs an inside tool"
msgstr "{tool}: posición de herramienta incorrecta – el mecanizado interior necesita una herramienta interior"

#: drehzyklen/cycles/toolcheck.py:55
#, python-brace-format
msgid "{tool}: wrong tool position - outside machining needs an outside tool"
msgstr "{tool}: posición de herramienta incorrecta – el mecanizado exterior necesita una herramienta exterior"

