msgstr "{tool}: con {kind} no se puede roscar – elegir una herramienta de roscar"

#: drehzyklen/cycles/thread.py:255
#, python-brace-format
msgid "{tool}: an inside thread needs an inside threading tool"
msgstr "{tool}: una rosca interior necesita una herramienta de roscar interior"

#: drehzyklen/cycles/thread.py:258
#, python-brace-format
msgid "{tool}: an outside thread needs an outside threading tool"
msgstr "{tool}: una rosca exterior necesita una herramienta de roscar exterior"

