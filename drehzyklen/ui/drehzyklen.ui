<?xml version="1.0" encoding="UTF-8"?>
<!--
  Drehzyklen - layout of the user interface (GtkBuilder, editable with Glade or Cambalache).
  The program fills these places at runtime:
    page_stack     the pages stock, cycles, tools (tool_page below)
    cycle_bar      one button per cycle (stock ... G-code)
    view_slot      the preview/picture
    message_slot   the messages under the preview
    machine_form_scroller  the input fields of the machine data
  Buttons may be moved freely. Keep the ids and the signal handlers. Drawn icons: a
  GtkDrawingArea with the widget name "icon:<key>" (send, menu, tools, gcode_view, ...).
  An own copy in ~/.config/drehzyklen/drehzyklen.ui is used instead of this file.
-->
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkListStore" id="program_store">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkListStore" id="tool_store">
    <columns>
      <column type="gint"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkBox" id="main_box">
    <property name="visible">True</property>
    <property name="orientation">vertical</property>
    <property name="spacing">2</property>
    <child>
      <object class="GtkBox" id="file_bar">
        <property name="visible">True</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">8</property>
        <property name="margin_start">2</property>
        <property name="margin_end">2</property>
        <property name="margin_top">2</property>
        <child>
          <object class="GtkButton" id="button_new">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">False</property>
            <property name="tooltip_text" translatable="yes">New program (the stock stays)</property>
            <signal name="clicked" handler="on_new"/>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">1</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">document-new</property>
                    <property name="icon_size">3</property>
                    <property name="visible">True</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">New</property>
                    <property name="visible">True</property>
                    <style>
                      <class name="buttontext"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="button_open">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">False</property>
            <property name="tooltip_text" translatable="yes">Open a project (.dzp)</property>
            <signal name="clicked" handler="on_open"/>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">1</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">document-open</property>
                    <property name="icon_size">3</property>
                    <property name="visible">True</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Open</property>
                    <property name="visible">True</property>
                    <style>
                      <class name="buttontext"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="button_save">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">False</property>
            <property name="tooltip_text" translatable="yes">Save the project (.dzp)</property>
            <signal name="clicked" handler="on_save_project"/>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">1</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon_name">document-save</property>
                    <property name="icon_size">3</property>
                    <property name="visible">True</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Save</property>
                    <property name="visible">True</property>
                    <style>
                      <class name="buttontext"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="button_send">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">False</property>
            <property name="tooltip_text" translatable="yes">Show the G-code, complete it, save it or send it to LinuxCNC</property>
            <signal name="clicked" handler="on_send"/>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">1</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkDrawingArea">
                    <property name="name">icon:send</property>
                    <property name="width_request">24</property>
                    <property name="height_request">24</property>
                    <property name="halign">center</property>
                    <property name="visible">True</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Send</property>
                    <property name="visible">True</property>
                    <style>
                      <class name="buttontext"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
          </packing>
        </child>
        <child>
          <object class="GtkRadioButton" id="page_settings">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">False</property>
            <property name="tooltip_text" translatable="yes">Settings: machine data and language</property>
            <property name="draw_indicator">False</property>
            <property name="group">page_tools</property>
            <signal name="toggled" handler="on_page_toggled"/>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">1</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkDrawingArea">
                    <property name="name">icon:menu</property>
                    <property name="width_request">24</property>
                    <property name="height_request">24</property>
                    <property name="halign">center</property>
                    <property name="visible">True</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Settings</property>
                    <property name="visible">True</property>
                    <style>
                      <class name="buttontext"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="pack_type">end</property>
          </packing>
        </child>
        <child>
          <object class="GtkRadioButton" id="page_tools">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">False</property>
            <property name="tooltip_text" translatable="yes">Tool table</property>
            <property name="draw_indicator">False</property>
            <signal name="toggled" handler="on_page_toggled"/>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">1</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkDrawingArea">
                    <property name="name">icon:tools</property>
                    <property name="width_request">24</property>
                    <property name="height_request">24</property>
                    <property name="halign">center</property>
                    <property name="visible">True</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Tools</property>
                    <property name="visible">True</property>
                    <style>
                      <class name="buttontext"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="pack_type">end</property>
          </packing>
        </child>
        <style>
          <class name="buttonbar"/>
          <class name="filebar"/>
        </style>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">False</property>
      </packing>
    </child>
    <child>
      <object class="GtkStack" id="main_stack">
        <property name="visible">True</property>
        <property name="transition_type">none</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkPaned" id="outer_paned">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="wide_handle">True</property>
            <child>
              <object class="GtkBox" id="program_column">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <property name="margin">4</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Program</property>
                    <style>
                      <class name="title"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="program_name">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="width_chars">8</property>
                    <property name="placeholder_text" translatable="yes">Program name</property>
                    <signal name="changed" handler="on_program_name_changed"/>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="shadow_type">in</property>
                    <child>
                      <object class="GtkTreeView" id="program_tree">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="model">program_store</property>
                        <property name="tooltip_column">4</property>
                        <signal name="row-activated" handler="on_program_row_activated"/>
                        <child>
                          <object class="GtkTreeViewColumn" id="program_column_0">
                            <property name="title">#</property>
                            <property name="resizable">True</property>
                            <child>
                              <object class="GtkCellRendererText"/>
                              <attributes>
                                <attribute name="text">0</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="program_column_1">
                            <property name="title" translatable="yes">Cycle</property>
                            <property name="resizable">True</property>
                            <child>
                              <object class="GtkCellRendererText">
                                <property name="ellipsize">end</property>
                              </object>
                              <attributes>
                                <attribute name="text">1</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="program_column_2">
                            <property name="title">T</property>
                            <property name="resizable">True</property>
                            <child>
                              <object class="GtkCellRendererText"/>
                              <attributes>
                                <attribute name="text">2</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="program_column_3">
                            <property name="title" translatable="yes">Data</property>
                            <property name="resizable">True</property>
                            <property name="expand">True</property>
                            <child>
                              <object class="GtkCellRendererText">
                                <property name="ellipsize">end</property>
                              </object>
                              <attributes>
                                <attribute name="text">3</attribute>
                              </attributes>
                            </child>
                          </object>
                        </child>
                        <child internal-child="selection">
                          <object class="GtkTreeSelection" id="program_selection">
                            <signal name="changed" handler="on_program_selection_changed"/>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkGrid">
                    <property name="visible">True</property>
                    <property name="row_spacing">4</property>
                    <property name="column_spacing">4</property>
                    <property name="column_homogeneous">True</property>
                    <child>
                      <object class="GtkButton" id="button_up">
                        <property name="label">▲</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="hexpand">True</property>
                        <property name="tooltip_text" translatable="yes">Move up</property>
                        <signal name="clicked" handler="on_move_up"/>
                      </object>
                      <packing>
                        <property name="left_attach">0</property>
                        <property name="top_attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="button_down">
                        <property name="label">▼</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="hexpand">True</property>
                        <property name="tooltip_text" translatable="yes">Move down</property>
                        <signal name="clicked" handler="on_move_down"/>
                      </object>
                      <packing>
                        <property name="left_attach">1</property>
                        <property name="top_attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="button_edit">
                        <property name="label">✎</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="hexpand">True</property>
                        <property name="tooltip_text" translatable="yes">Edit (also double click)</property>
                        <signal name="clicked" handler="on_edit"/>
                      </object>
                      <packing>
                        <property name="left_attach">2</property>
                        <property name="top_attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="button_duplicate">
                        <property name="label">⧉</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="hexpand">True</property>
                        <property name="tooltip_text" translatable="yes">Duplicate</property>
                        <signal name="clicked" handler="on_duplicate"/>
                      </object>
                      <packing>
                        <property name="left_attach">3</property>
                        <property name="top_attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="button_delete">
                        <property name="label">✖</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="hexpand">True</property>
                        <property name="tooltip_text" translatable="yes">Delete</property>
                        <signal name="clicked" handler="on_delete"/>
                      </object>
                      <packing>
                        <property name="left_attach">4</property>
                        <property name="top_attach">0</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="program_status">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="wrap">True</property>
                    <property name="max_width_chars">28</property>
                    <style>
                      <class name="hint"/>
                    </style>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="resize">False</property>
                <property name="shrink">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkPaned" id="inner_paned">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="wide_handle">True</property>
                <child>
                  <object class="GtkFrame" id="middle_frame">
                    <property name="visible">True</property>
                    <property name="label_xalign">0</property>
                    <property name="shadow_type">in</property>
                    <child>
                      <object class="GtkStack" id="page_stack">
                        <property name="visible">True</property>
                        <property name="transition_type">none</property>
                      </object>
                    </child>
                    <style>
                      <class name="column"/>
                    </style>
                  </object>
                  <packing>
                    <property name="resize">False</property>
                    <property name="shrink">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkFrame" id="view_frame">
                    <property name="visible">True</property>
                    <property name="label_xalign">0</property>
                    <property name="shadow_type">in</property>
                    <child>
                      <object class="GtkBox" id="view_column">
                        <property name="visible">True</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                        <property name="margin">4</property>
                        <child>
                          <object class="GtkBox" id="view_bar">
                            <property name="visible">True</property>
                            <property name="orientation">horizontal</property>
                            <property name="spacing">4</property>
                            <child>
                              <object class="GtkRadioButton" id="view_cycle">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="receives_default">False</property>
                                <property name="tooltip_text" translatable="yes">Preview of the current tab with stock and removal; the mouse wheel zooms, the left mouse button pans, a double click resets</property>
                                <property name="draw_indicator">False</property>
                                <signal name="toggled" handler="on_view_mode_toggled"/>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">1</property>
                                    <property name="visible">True</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon_name">video-display</property>
                                        <property name="icon_size">3</property>
                                        <property name="visible">True</property>
                                      </object>
                                      <packing>
                                        <property name="expand">True</property>
                                        <property name="fill">True</property>
                                      </packing>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Cycle</property>
                                        <property name="visible">True</property>
                                        <style>
                                          <class name="buttontext"/>
                                        </style>
                                      </object>
                                      <packing>
                                        <property name="expand">False</property>
                                        <property name="fill">False</property>
                                      </packing>
                                    </child>
                                  </object>
                                </child>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">False</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkRadioButton" id="view_help">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="receives_default">False</property>
                                <property name="tooltip_text" translatable="yes">Parameter picture of the current tab</property>
                                <property name="draw_indicator">False</property>
                                <property name="group">view_cycle</property>
                                <signal name="toggled" handler="on_view_mode_toggled"/>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">1</property>
                                    <property name="visible">True</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon_name">image-x-generic</property>
                                        <property name="icon_size">3</property>
                                        <property name="visible">True</property>
                                      </object>
                                      <packing>
                                        <property name="expand">True</property>
                                        <property name="fill">True</property>
                                      </packing>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Picture</property>
                                        <property name="visible">True</property>
                                        <style>
                                          <class name="buttontext"/>
                                        </style>
                                      </object>
                                      <packing>
                                        <property name="expand">False</property>
                                        <property name="fill">False</property>
                                      </packing>
                                    </child>
                                  </object>
                                </child>
                              </object>
                              <packing>
                                <property name="expand">False</property>
                                <property name="fill">False</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkRadioButton" id="view_gcode">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="receives_default">False</property>
                                <property name="tooltip_text" translatable="yes">Generated G-code, jumps to the marked program step</property>
                                <property name="draw_indicator">False</property>
                                <property name="group">view_cycle</property>
                                <signal name="toggled" handler="on_view_mode_toggled"/>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">1</property>
                                    <property name="visible">True</property>
                                    <child>
                                      <object class="GtkDrawingArea">
                                        <property name="name">icon:gcode_view</property>
                                        <property name="width_request">24</property>
                                        <property name="height_request">24</property>
                                        <property name="halign">center</property>
                                        <property name="visible">True</property>
                                      </object>
                                      <packing>
                                        <property name="expand">True</property>
